{
  "name": "storeguard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"node --import tsx --watch apps/api/src/index.ts\" \"vite --config apps/web/vite.config.ts\"",
    "start": "concurrently -k -n API,WEB \"node --import tsx apps/api/src/index.ts\" \"vite preview --config apps/web/vite.config.ts\"",
    "build": "pnpm typecheck && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "browser:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "fastify": "^5.6.2",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.58.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tldts": "^7.4.18",
    "umzug": "^3.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
